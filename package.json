{
  "name": "oneshot",
  "productName": "OneShot",
  "version": "0.1.1",
  "description": "A simple-on-the-surface, deep-underneath screenshot tool and image viewer.",
  "main": "main.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.mjs\"",
    "smoke": "node scripts/smoke.mjs",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run smoke",
    "icon": "node scripts/make-icon.mjs",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:all": "electron-builder --mac --win --linux --publish never",
    "preversion": "npm test",
    "release:mac": "./scripts/release-mac.sh",
    "release:patch": "npm version patch -m \"Release v%s\" && git push && npm run release:mac",
    "release:minor": "npm version minor -m \"Release v%s\" && git push && npm run release:mac",
    "release:major": "npm version major -m \"Release v%s\" && git push && npm run release:mac",
    "postinstall": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0"
  },
  "build": {
    "appId": "app.oneshot.mac",
    "productName": "OneShot",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "image-types.js",
      "package.json",
      "renderer/**/*"
    ],
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "OneShot needs Screen Recording access to take screenshots."
      },
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics",
      "maintainer": "OneShot",
      "mimeTypes": [
        "image/png",
        "image/jpeg",
        "image/gif",
        "image/webp",
        "image/heic",
        "image/heif",
        "image/tiff",
        "image/bmp",
        "image/avif"
      ]
    },
    "fileAssociations": [
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "gif",
          "webp",
          "heic",
          "heif",
          "tif",
          "tiff",
          "bmp",
          "avif"
        ],
        "name": "Image",
        "role": "Editor",
        "rank": "Default"
      }
    ]
  }
}
